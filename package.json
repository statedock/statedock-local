{
  "name": "statedock-local",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "node --import tsx --test apps/local/src/*.test.js apps/local/src/*.test.ts packages/core/dist/*.test.js apps/mcp/dist/*.test.js",
    "dev": "pnpm build && pnpm --filter @statedock/local dev",
    "start": "node apps/local/dist/index.js",
    "web": "pnpm --filter @statedock/web dev",
    "format": "prettier --write \"{apps,packages}/**/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{apps,packages}/**/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "fake-indexeddb": "6.2.4",
    "prettier": "3.6.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "license": "AGPL-3.0-only"
}
